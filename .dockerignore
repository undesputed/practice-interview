# Keep the build context small and secrets out of the image.
.git
.gitignore
.gitattributes

# Virtualenvs / caches (huge, host-specific)
.venv
venv
__pycache__
*.pyc
*.pyo
.pytest_cache
.mypy_cache
.ruff_cache

# Secrets and runtime data — never bake these in
.env
*.env
backend/.env
sessions/

# Not needed at runtime
tests/
docs/
deploy/
pytest.ini
*.mvbn d
.DS_Store
``