# Long-lived Deepgram key — stays server-side, used to mint ephemeral tokens.
DEEPGRAM_API_KEY=
# Anthropic key — used for the agent "think" provider and post-interview coaching.
ANTHROPIC_API_KEY=
# LOCAL DEV ONLY. If your Deepgram key cannot mint ephemeral tokens (403 on
# /v1/auth/grant), set this to 1 to send the long-lived key to the browser so the
# interview can run locally. NEVER set this on a deployed/EC2 server — it exposes
# the key. The proper fix for deployment is a Deepgram key WITH grant permission.
# DEEPGRAM_ALLOW_BROWSER_KEY=1

# Set to 1 to enable emotion analysis: the live Facial screen's emotion engine and the
# post-interview emotion track. Requires the optional install
# `pip install -r backend/requirements-emotion.txt` (HSEmotion / ONNX). Leave unset to disable.
# EMOTION_ANALYSIS=1

# Emotion model (HSEmotion / AffectNet). Default "enet_b2_8" (most accurate); set a
# lighter variant like "enet_b0_8_best_vgaf" if scoring feels slow.
# HSEMOTION_MODEL=enet_b2_8
